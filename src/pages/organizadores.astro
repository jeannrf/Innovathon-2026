---
import Layout from '../layouts/Layout.astro';
import OrgCard from '../components/OrgCard.astro';

const organizadores = [
  { 
    name: "CEIIS", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Comunidad de Estudiantes de Ingeniería de Sistemas de la Universidad Nacional de Ingeniería, impulsando la innovación tecnológica." 
  },
  { 
    name: "CCAT", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Centro Cultural de Avanzada Tecnológica, promoviendo la investigación y el desarrollo de software científico y aplicado." 
  },
  { 
    name: "CODE", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Comunidad de desarrollo y programación competitiva FIIS-UNI, formando talentos para resolver retos reales." 
  },
];

const coorganizadores = [
  { 
    name: "Proyecta UNI", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Organización líder en dirección estratégica y formulación de proyectos multidisciplinarios en la UNI." 
  },
  { 
    name: "Coorganizador 2", 
    logo: "", 
    linkedin: "#" 
  },
  { 
    name: "Coorganizador 3", 
    logo: "", 
    linkedin: "#" 
  },
  { 
    name: "DSC UTP", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Google Developer Student Club UTP, conectando estudiantes con herramientas y mentores de Google." 
  },
];

const aliados = [
  { name: "Startup UNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "OTI UNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "Aliado 3", logo: "", linkedin: "#" },
  { name: "Aliado 4", logo: "", linkedin: "#" },
  { name: "Equipu", logo: "", linkedin: "https://linkedin.com" },
];

const auspiciadores = [
  { name: "Datux", logo: "", linkedin: "https://linkedin.com" },
  { name: "CCL", logo: "", linkedin: "https://linkedin.com" },
  { name: "ASEP", logo: "", linkedin: "https://linkedin.com" },
  { name: "scale", logo: "", linkedin: "https://linkedin.com" },
  { name: "Auspiciador 5", logo: "", linkedin: "#" },
  { name: "Fundación WE", logo: "", linkedin: "https://linkedin.com" },
];

const patrocinadores = [
  { name: "Tai Loy", logo: "", linkedin: "https://linkedin.com" },
  { name: "Minsun", logo: "", linkedin: "https://linkedin.com" },
  { name: "Deltron", logo: "", linkedin: "https://linkedin.com" },
  { name: "Patrocinador 4", logo: "", linkedin: "#" },
  { name: "ProUNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "Patrocinador 6", logo: "", linkedin: "#" },
];
---

<Layout title="Organizadores">
  <!-- HERO -->
  <section class="relative pt-32 pb-16 overflow-hidden min-h-[60vh] flex items-center">
    <!-- Ambient Glows (matching index.astro aesthetic) -->
    <div class="absolute left-1/3 -top-[20%] w-[600px] h-[600px] rounded-full bg-[var(--theme-color-glow)] blur-[130px] pointer-events-none opacity-25 z-0"></div>
    <div class="absolute right-[10%] top-1/4 w-[350px] h-[350px] rounded-full bg-[var(--theme-color-glow)] blur-[100px] pointer-events-none opacity-20 z-0"></div>

    <div class="container-custom relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column: Title & Intro -->
        <div class="lg:col-span-7 text-left space-y-6">
          <h1 
            class="text-4xl md:text-5xl font-light text-white tracking-tight reveal" 
            style="font-family: var(--font-display);"
          >
            Organizadores
          </h1>
          
          <p class="text-slate-400 text-lg leading-relaxed reveal reveal-delayed max-w-2xl">
            Conéctate con el motor del cambio. Detrás de la Innovathon hay una alianza sin precedentes de comunidades, universidades y empresas líderes en tecnología. Ellos serán tus mentores, tus jurados y, potencialmente, tus futuros empleadores o socios estratégicos.
          </p>
        </div>

        <!-- Right Column: Interactive Placeholder for Future 3D Animation/Image -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end reveal reveal-delayed">
          <div class="relative w-full aspect-square max-w-[360px] md:max-w-[400px] flex items-center justify-center">
            <!-- Animated spinning borders -->
            <div class="absolute inset-0 rounded-3xl border border-dashed border-slate-800/80 flex items-center justify-center">
              <div class="absolute w-[85%] h-[85%] rounded-full border border-dashed border-slate-700/30 animate-[spin_60s_linear_infinite]"></div>
              <div class="absolute w-[70%] h-[70%] rounded-full border border-dotted border-slate-600/20 animate-[spin_30s_linear_infinite_reverse]"></div>
            </div>
            
            <!-- Core glowing element -->
            <div class="relative w-40 h-40 rounded-2xl bg-slate-900/60 border border-slate-800/80 flex flex-col items-center justify-center backdrop-blur-xl shadow-[0_0_50px_rgba(0,0,0,0.5)] group hover:border-[var(--theme-color-primary)]/50 transition-all duration-500 ease-out overflow-hidden">
              <!-- Radial background glow -->
              <div class="absolute inset-0 bg-gradient-to-tr from-[var(--theme-color-primary)]/10 to-[var(--theme-color-secondary)]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
              
              <!-- Floating Icon -->
              <div class="relative transform group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-500 ease-out">
                <svg class="w-14 h-14 text-slate-500/80 group-hover:text-[var(--theme-color-primary)] transition-colors duration-500 animate-[bounce_3s_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </div>
              
              <!-- Mini tag -->
              <span class="absolute bottom-4 text-[9px] text-slate-500 font-mono tracking-widest uppercase text-center w-full px-2">
                Espacio de Animación
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTIONS GRID -->
  <section class="py-12 pb-32 relative z-10">
    <div class="container-custom space-y-24">
      
      <!-- 1. ORGANIZADORES CORE (Large Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Organizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {organizadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              description={org.description}
              size="large" 
            />
          ))}
        </div>
      </div>

      <!-- 2. COORGANIZADORES (Medium-Large Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Coorganizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
          {coorganizadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              description={org.description}
              size="medium-large" 
            />
          ))}
        </div>
      </div>

      <!-- 3. ALIADOS (Medium Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Aliados
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 max-w-5xl mx-auto">
          {aliados.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              size="medium" 
            />
          ))}
        </div>
      </div>

      <!-- 4. AUSPICIADORES (Medium-Small Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Auspiciadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
          {auspiciadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              size="small" 
            />
          ))}
        </div>
      </div>

      <!-- 5. PATROCINADORES (Small Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Patrocinadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
          {patrocinadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              size="small" 
            />
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
