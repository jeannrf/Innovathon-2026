---
import Layout from '../layouts/Layout.astro';
import OrgCard from '../components/OrgCard.astro';

const organizadores = [
  { 
    name: "CEIIS", 
    logo: "/images/logos/ceiis.png", 
    linkedin: "https://www.linkedin.com/company/ceiisuni/", 
    description: "Comunidad de Estudiantes de Ingeniería de Sistemas de la Universidad Nacional de Ingeniería, dedicada a impulsar la innovación tecnológica, el desarrollo de proyectos y la capacitación constante de futuros líderes en el sector TI." 
  },
  { 
    name: "CCAT", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Centro Cultural de Avanzada Tecnológica de la UNI, promoviendo activamente la investigación científica, el desarrollo de software de alto impacto y la formación de talento técnico de excelencia." 
  },
  { 
    name: "CODE", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Comunidad de desarrollo y programación competitiva de la FIIS-UNI, enfocada en la formación de talentos de alto rendimiento para resolver problemas algorítmicos complejos y retos del mundo real." 
  },
];

const coorganizadores = [
  { 
    name: "Proyecta UNI", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Organización estudiantil líder en dirección estratégica y formulación de proyectos multidisciplinarios con impacto social y tecnológico, conectando a la academia con la industria." 
  },
  { 
    name: "Coorganizador 2", 
    logo: "", 
    linkedin: "#",
    description: ""
  },
  { 
    name: "Coorganizador 3", 
    logo: "", 
    linkedin: "#",
    description: ""
  },
  { 
    name: "DSC UTP", 
    logo: "", 
    linkedin: "https://linkedin.com", 
    description: "Google Developer Student Club de la UTP, un espacio de aprendizaje e innovación tecnológica que conecta a estudiantes con herramientas, recursos y mentores experimentados de Google." 
  },
];

const aliados = [
  { name: "Startup UNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "OTI UNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "Aliado 3", logo: "", linkedin: "#" },
  { name: "Aliado 4", logo: "", linkedin: "#" },
  { name: "Equipu", logo: "", linkedin: "https://linkedin.com" },
];

const auspiciadores = [
  { name: "Datux", logo: "", linkedin: "https://linkedin.com" },
  { name: "CCL", logo: "", linkedin: "https://linkedin.com" },
  { name: "ASEP", logo: "", linkedin: "https://linkedin.com" },
  { name: "scale", logo: "", linkedin: "https://linkedin.com" },
  { name: "Auspiciador 5", logo: "", linkedin: "#" },
  { name: "Fundación WE", logo: "", linkedin: "https://linkedin.com" },
];

const patrocinadores = [
  { name: "Tai Loy", logo: "", linkedin: "https://linkedin.com" },
  { name: "Minsun", logo: "", linkedin: "https://linkedin.com" },
  { name: "Deltron", logo: "", linkedin: "https://linkedin.com" },
  { name: "Patrocinador 4", logo: "", linkedin: "#" },
  { name: "ProUNI", logo: "", linkedin: "https://linkedin.com" },
  { name: "Patrocinador 6", logo: "", linkedin: "#" },
];
---

<Layout title="Organizadores">
  <!-- HERO -->
  <section class="relative pt-32 pb-16 overflow-hidden min-h-[60vh] flex items-center">
    <!-- Ambient Glows (matching index.astro aesthetic) -->
    <div class="absolute left-1/3 -top-[20%] w-[600px] h-[600px] rounded-full bg-[var(--theme-color-glow)] blur-[130px] pointer-events-none opacity-25 z-0"></div>
    <div class="absolute right-[10%] top-1/4 w-[350px] h-[350px] rounded-full bg-[var(--theme-color-glow)] blur-[100px] pointer-events-none opacity-20 z-0"></div>

    <div class="container-custom relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column: Title & Intro -->
        <div class="lg:col-span-6 text-left space-y-6">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-light mb-4 text-white tracking-tight reveal" style="font-family: var(--font-display);">
            Organizadores
          </h1>
          
          <p class="text-slate-300/80 text-lg leading-relaxed font-light reveal reveal-delayed max-w-lg">
            Conéctate con el motor del cambio. Detrás de la Innovathon hay una alianza sin precedentes de comunidades, universidades y empresas líderes en tecnología. Ellos serán tus mentores, tus jurados y, potencialmente, tus futuros empleadores o socios estratégicos.
          </p>
        </div>

        <!-- Right Column: Space for future visual -->
        <div class="lg:col-span-6 flex justify-center lg:justify-end reveal reveal-delayed">
        </div>
      </div>
    </div>
  </section>

  <!-- SECTIONS GRID -->
  <section class="py-12 pb-32 relative z-10">
    <div class="container-custom space-y-24">
      
      <!-- 1. ORGANIZADORES CORE (Large Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Organizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {organizadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              logo={org.logo}
              description={org.description}
              size="large" 
            />
          ))}
        </div>
      </div>

      <!-- 2. COORGANIZADORES (Medium-Large Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Coorganizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
          {coorganizadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              logo={org.logo}
              description={org.description}
              size="medium-large" 
            />
          ))}
        </div>
      </div>

      <!-- 3. ALIADOS (Medium Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Aliados
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 max-w-5xl mx-auto">
          {aliados.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              logo={org.logo}
              size="medium" 
            />
          ))}
        </div>
      </div>

      <!-- 4. AUSPICIADORES (Medium-Small Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Auspiciadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
          {auspiciadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              logo={org.logo}
              size="small" 
            />
          ))}
        </div>
      </div>

      <!-- 5. PATROCINADORES (Small Cards) -->
      <div class="reveal">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Patrocinadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-5xl mx-auto">
          {patrocinadores.map(org => (
            <OrgCard 
              name={org.name} 
              linkedin={org.linkedin} 
              logo={org.logo}
              size="small" 
            />
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
