---
// src/pages/organizadores.astro
import Layout from '../layouts/Layout.astro';
import OrgCard from '../components/OrgCard.astro';

const organizadores = [
  { name: "CEIIS", logo: "/images/logos/ceiis_logo_azul_birefnet.png", linkedin: "https://www.linkedin.com/company/ceiisuni/" },
  { name: "CCAT", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "UNICODE", logo: "/images/logos/unicode_logo.png", linkedin: "https://www.linkedin.com/company/ccunicode/posts/?feedView=all" },
];

const coorganizadores = [
  { name: "Proyecta UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "IEEE WIE UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "AIESEC UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "DSC UTP", logo: "", linkedin: "https://www.linkedin.com/feed/" },
];

const aliados = [
  { name: "Startup UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "OTI UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "IEEE UNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "UNI.NET", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Equipu", logo: "", linkedin: "https://www.linkedin.com/feed/" },
];

const auspiciadores = [
  { name: "Datux", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "CCL", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "ASEP", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Scale", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Kunan", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Fundación WE", logo: "", linkedin: "https://www.linkedin.com/feed/" },
];

const patrocinadores = [
  { name: "Tai Loy", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Minsun", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Deltron", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Coolbox", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "ProUNI", logo: "", linkedin: "https://www.linkedin.com/feed/" },
  { name: "Lenovo", logo: "", linkedin: "https://www.linkedin.com/feed/" },
];
---

<Layout title="Organizadores">
  <!-- HERO -->
  <section class="relative pt-36 pb-20 overflow-x-clip min-h-[50vh] flex items-center">
    <!-- Ambient Glows (matching index.astro aesthetic) -->
    <div class="absolute left-1/3 -top-[20%] w-[600px] h-[600px] rounded-full bg-[var(--theme-color-glow)] blur-[130px] pointer-events-none opacity-20 z-0"></div>
    <div class="absolute right-[10%] top-1/4 w-[350px] h-[350px] rounded-full bg-[var(--theme-color-glow)] blur-[100px] pointer-events-none opacity-15 z-0"></div>

    <!-- Centered Gradient Glow behind the title -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[600px] h-[300px] rounded-full bg-gradient-to-tr from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] blur-[100px] sm:blur-[140px] pointer-events-none opacity-25 z-0"></div>

    <div class="container-custom relative z-10 w-full text-center">
      <div class="max-w-3xl mx-auto space-y-6">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-light tracking-tight bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] bg-clip-text text-transparent transition-all duration-500 reveal pb-3 leading-tight" style="font-family: 'Poppins', sans-serif;">
          Organizadores
        </h1>
        <div class="w-24 h-[2px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto my-4 reveal"></div>
        
        <p class="text-slate-300/80 text-base sm:text-xl leading-relaxed font-light reveal reveal-delayed max-w-2xl mx-auto">
          Conéctate con el motor del cambio. Detrás de la Innovathon hay una alianza sin precedentes de comunidades, universidades y empresas líderes en tecnología. Ellos serán tus mentores, tus jurados y, potencialmente, tus futuros empleadores o socios estratégicos.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTIONS GRID (Option B - Logos Only) -->
  <section class="py-12 pb-32 relative z-10">
    <div class="container-custom space-y-20">
      
      <!-- 1. ORGANIZADORES CORE -->
      <div class="reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Organizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="flex flex-wrap gap-6 justify-center max-w-5xl mx-auto">
          {organizadores.map(org => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)] shrink-0">
              <OrgCard 
                name={org.name} 
                linkedin={org.linkedin} 
                logo={org.logo}
              />
            </div>
          ))}
        </div>
      </div>

      <!-- 2. COORGANIZADORES -->
      <div class="reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Coorganizadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="flex flex-wrap gap-6 justify-center max-w-5xl mx-auto">
          {coorganizadores.map(org => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)] shrink-0">
              <OrgCard 
                name={org.name} 
                linkedin={org.linkedin} 
                logo={org.logo}
              />
            </div>
          ))}
        </div>
      </div>

      <!-- 3. ALIADOS -->
      <div class="reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Aliados
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="flex flex-wrap gap-6 justify-center max-w-5xl mx-auto">
          {aliados.map(org => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)] shrink-0">
              <OrgCard 
                name={org.name} 
                linkedin={org.linkedin} 
                logo={org.logo}
              />
            </div>
          ))}
        </div>
      </div>

      <!-- 4. AUSPICIADORES -->
      <div class="reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Auspiciadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="flex flex-wrap gap-6 justify-center max-w-5xl mx-auto">
          {auspiciadores.map(org => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)] shrink-0">
              <OrgCard 
                name={org.name} 
                linkedin={org.linkedin} 
                logo={org.logo}
              />
            </div>
          ))}
        </div>
      </div>

      <!-- 5. PATROCINADORES -->
      <div class="reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-light text-white tracking-wide" style="font-family: var(--font-display);">
            Patrocinadores
          </h2>
          <div class="w-12 h-[1px] bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] mx-auto mt-3"></div>
        </div>
        
        <div class="flex flex-wrap gap-6 justify-center max-w-5xl mx-auto">
          {patrocinadores.map(org => (
            <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-18px)] shrink-0">
              <OrgCard 
                name={org.name} 
                linkedin={org.linkedin} 
                logo={org.logo}
              />
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
