---
import Layout from "../layouts/Layout.astro";
import CardHomeMain from "../components/home/CardHomeMain.astro";
import CardHomeStat from "../components/home/CardHomeStat.astro";
import CardHomePrize from "../components/home/CardHomePrize.astro";
---

<Layout title="Inicio">
	<!-- HERO -->
	<section
		class="relative flex items-center justify-center"
		style="min-height: calc(100vh - 64px);"
	>
		<!-- Ambient orbs / Dynamic Gradient Mesh -->
		<div class="hero-bg-glow hero-bg-glow--1"></div>
		<div class="hero-bg-glow hero-bg-glow--2"></div>
		<div class="hero-bg-glow hero-bg-glow--3"></div>
		<div class="hero-bg-glow hero-bg-glow--4"></div>
		<!-- Noise Overlay for Cinematic Texture & Banding elimination -->
		<div class="hero-noise"></div>
		<!-- Grid pattern -->
		<div class="hero-grid"></div>

		<div class="container-custom text-center relative z-10 pb-16">
			<h1
				class="text-6xl md:text-8xl lg:text-9xl font-extralight tracking-tight mb-4 hero-title"
				style="font-family: var(--font-display);"
			>
				Innovathon
			</h1>
			<h2
				class="text-3xl md:text-5xl lg:text-6xl font-light tracking-tight mb-10 bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] bg-clip-text text-transparent transition-all duration-500"
				style="font-family: var(--font-display);"
			>
				"Launch with AI"
			</h2>
			<p
				class="text-lg md:text-xl text-slate-300/80 max-w-2xl mx-auto mb-14 leading-relaxed font-light"
			>
				Descubre el evento de innovación en la UNI donde tus ideas se
				transforman en impacto real mediante Inteligencia Artificial y
				metodologías ágiles.
			</p>

			<div class="flex flex-wrap justify-center gap-5">
				<a
					href="#"
					class="btn-animate-rgb px-8 py-3.5 rounded-xl font-semibold text-white cursor-pointer"
				>
					<span class="relative z-10 flex items-center gap-2">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
							><path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
							></path><path
								d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.613.613l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.352 0-4.55-.764-6.324-2.057l-.44-.33-3.28 1.1 1.1-3.28-.33-.44A9.965 9.965 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"
							></path></svg
						>
						Canal de Whatsapp
					</span>
				</a>
				<a
					href="#"
					class="group relative px-8 py-3.5 rounded-xl font-semibold text-white border border-white/20 hover:border-[#818cf8]/50 transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_rgba(129,140,248,0.2)] bg-white/5 hover:bg-white/10 backdrop-blur-sm cursor-pointer"
				>
					<span class="flex items-center gap-2">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
							><path
								d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286z"
							></path></svg
						>
						Canal de Discord
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- HIGHLIGHTS -->
	<section class="py-20 md:py-28 relative z-20">
		<div class="container-custom">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
				<CardHomeMain
					title="Modalidad"
					value="Presencial / UNI"
					icon="map-pin"
				/>
				<CardHomeMain title="Fechas" value="Próximamente" icon="calendar" />
				<CardHomeMain
					title="Premios"
					value="Próximamente"
					icon="trophy"
					valueClass="bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] bg-clip-text text-transparent font-semibold"
					iconClass="text-[var(--theme-color-primary)]"
				/>
			</div>
		</div>
	</section>

	<!-- QUÉ ES LA INNOVATHON -->
	<section class="py-24 relative z-10">
		<!-- Dynamic Ambient Glows for Mid Section -->
		<div
			class="absolute -left-[10%] top-1/4 w-[400px] h-[400px] rounded-full bg-[var(--theme-color-glow)] blur-[100px] pointer-events-none opacity-40 z-0"
		>
		</div>
		<div
			class="absolute -right-[10%] bottom-1/4 w-[350px] h-[350px] rounded-full bg-[var(--theme-color-glow)] blur-[90px] pointer-events-none opacity-30 z-0"
		>
		</div>
		<div class="container-custom relative z-10">
			<div
				class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
			>
				<!-- Text Content -->
				<div class="reveal">
					<h3
						class="text-4xl md:text-5xl font-light text-white mb-6"
						style="font-family: var(--font-display);"
					>
						¿Qué es la <br />
						<span
							class="font-semibold bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] bg-clip-text text-transparent"
							>Innovathon?</span
						>
					</h3>
					<div
						class="space-y-6 text-slate-300/80 text-lg font-light leading-relaxed"
					>
						<p>
							La Innovathon es el punto de encuentro donde el talento
							universitario peruano converge con la tecnología de vanguardia.
							Durante semanas intensivas de trabajo, equipos multidisciplinarios
							transforman ideas disruptivas en soluciones funcionales.
						</p>
						<p>
							No es solo una competencia, es una <strong
								>incubadora acelerada</strong
							>. Guiados por mentores expertos y potenciados por Inteligencia
							Artificial, los participantes aprenden a construir productos
							reales que respondan a los desafíos del mañana.
						</p>
					</div>
					<div class="mt-8 flex flex-wrap gap-4">
						<div class="flex items-center gap-2">
							<div
								class="w-1.5 h-1.5 rounded-full bg-[var(--theme-color-primary)]"
							>
							</div>
							<span
								class="text-sm text-slate-400 uppercase tracking-widest font-semibold"
								>Tecnología</span
							>
						</div>
						<div class="flex items-center gap-2">
							<div
								class="w-1.5 h-1.5 rounded-full bg-[var(--theme-color-primary)]"
							>
							</div>
							<span
								class="text-sm text-slate-400 uppercase tracking-widest font-semibold"
								>Desarrollo</span
							>
						</div>
						<div class="flex items-center gap-2">
							<div
								class="w-1.5 h-1.5 rounded-full bg-[var(--theme-color-secondary)]"
							>
							</div>
							<span
								class="text-sm text-slate-400 uppercase tracking-widest font-semibold"
								>Emprendimiento</span
							>
						</div>
					</div>
				</div>

				<!-- Visual Box -->
				<div class="relative reveal reveal-delayed">
					<!-- Ambient Glow behind the photo (deep, very soft, no harsh borders) -->
					<div
						class="absolute -inset-10 bg-[var(--theme-color-glow)] rounded-[3rem] blur-[80px] pointer-events-none opacity-45"
					>
					</div>

					<!-- Main Visual Container with Razor-Thin Dynamic Gradient Marco -->
					<div
						class="relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden p-[1.5px] transition-all duration-500"
						style="background: linear-gradient(135deg, var(--theme-color-primary), var(--theme-color-secondary));"
					>
						<div class="w-full h-full rounded-[1.9rem] bg-slate-950 p-2">
							<div
								class="w-full h-full rounded-[1.4rem] bg-slate-900 overflow-hidden relative group"
							>
								<img
									src="/images/photos_innovathon_2025/Innovathon_photo_final_2025_v1.webp"
									alt="Innovathon 2025"
									class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
								/>
								<div
									class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
								>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- AUSPICIADORES -->
	<section class="py-16 relative z-10">
		<div class="container-custom text-center">
			<p
				class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em] mb-10"
			>
				Auspiciado por
			</p>
			<div class="flex flex-wrap justify-center items-center gap-10 md:gap-16">
				<div class="sponsor-logo">
					<span
						class="text-xl font-black tracking-wider text-white/40 hover:text-white transition-all duration-500"
						>Zoom</span
					>
				</div>
				<div class="sponsor-logo">
					<span
						class="text-xl font-black tracking-wider text-white/40 hover:text-white transition-all duration-500"
						>Linear</span
					>
				</div>
				<div class="sponsor-logo">
					<span
						class="text-xl font-black tracking-wider text-white/40 hover:text-white transition-all duration-500"
						>Wahoo</span
					>
				</div>
				<div class="sponsor-logo">
					<span
						class="text-xl font-black tracking-wider text-white/40 hover:text-white transition-all duration-500"
						>Webflow</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- INNOVATHON 2025 -->
	<section class="py-24 relative z-10">
		<!-- Dynamic Ambient Glows for Lower Section -->
		<div
			class="absolute right-[5%] top-1/3 w-[500px] h-[500px] rounded-full bg-[var(--theme-color-glow)] blur-[120px] pointer-events-none opacity-30 z-0"
		>
		</div>
		<div
			class="absolute left-[5%] bottom-1/3 w-[450px] h-[450px] rounded-full bg-[var(--theme-color-glow)] blur-[110px] pointer-events-none opacity-25 z-0"
		>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-b from-transparent via-[var(--theme-color-glow)] to-transparent pointer-events-none z-0"
		>
		</div>
		<div class="container-custom relative z-10">
			<div class="text-center mb-16 reveal">
				<h3
					class="text-4xl md:text-5xl font-light text-white mb-4"
					style="font-family: var(--font-display);"
				>
					Innovathon <span
						class="bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] bg-clip-text text-transparent font-semibold"
						>2025</span
					>
				</h3>
				<p class="text-slate-400 text-lg max-w-xl mx-auto font-light">
					Lo que nos dejó la primera edición del evento que unió talento,
					tecnología e innovación.
				</p>
			</div>

			<!-- Stats -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16 reveal-stagger">
				<CardHomeStat value="+50" label="Participantes" />
				<CardHomeStat value="+12" label="Proyectos" />
				<CardHomeStat value="+10" label="Mentores" />
				<CardHomeStat value="+4" label="Semanas de trabajo" />
			</div>

			<!-- Proyectos ganadores (Podium Layout) -->
			<div
				class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 items-center reveal mt-28 mb-16 px-4 md:px-8"
			>
				<CardHomePrize
					place="second"
					placeLabel="Segundo Lugar"
					title="LlaMasabIA"
					description="Plataforma eduactiva impulsada con Inteligencia Artificial para las zonas rurales del Perú."
					badges={["Edtech", "IA"]}
					orderClass="order-2 md:order-1"
				/>

				<CardHomePrize
					place="first"
					placeLabel="Proyecto Ganador"
					title="SocIAleye"
					description="Proyecto que busca fortalecer la convivencia y el bienestar en las aulas mediante inteligencia artificial. Su enfoque permite identificar dinámicas sociales, detectar señales de riesgo y apoyar a docentes en la creación de entornos educativos más seguros e inclusivos."
					badges={["Educación", "IA", "Computer Vision"]}
					orderClass="order-1 md:order-2"
				/>

				<CardHomePrize
					place="third"
					placeLabel="Tercer Lugar"
					title="RiqchariyFinanzas"
					description="Finanzas educativas para escolares y personas iniciando en el ecosistema financiero."
					badges={["Fintech"]}
					orderClass="order-3"
				/>
			</div>
		</div>

		<!-- CTA FINAL -->
		<section class="py-24 relative z-10">
			<div class="container-custom reveal">
				<div class="glow-card glow-card--cta text-center relative">
					<div
						class="absolute -top-1/2 -left-1/4 w-96 h-96 bg-[var(--theme-color-glow)] rounded-full blur-[100px] pointer-events-none"
					>
					</div>
					<div
						class="absolute -bottom-1/2 -right-1/4 w-96 h-96 bg-[var(--theme-color-glow)] rounded-full blur-[100px] pointer-events-none"
					>
					</div>
					<div class="relative z-10">
						<h3
							class="text-3xl md:text-5xl font-light text-white mb-4"
							style="font-family: var(--font-display);"
						>
							¿Listo para innovar?
						</h3>
						<p class="text-slate-300 text-lg mb-8 max-w-lg mx-auto font-light">
							Sé parte de la 2da edición y transforma tus ideas en soluciones
							reales con IA.
						</p>
						<a
							href="/inscripcion"
							class="btn-animate-rgb inline-flex items-center gap-2 px-10 py-4 rounded-2xl font-bold text-white text-lg cursor-pointer"
						>
							Inscríbete Ahora
						</a>
					</div>
				</div>
			</div>
		</section>
	</section>

	<style is:global>
		/* ===== HERO ===== */
		.hero-bg-glow {
			position: absolute;
			border-radius: 50%;
			filter: blur(100px);
			pointer-events: none;
			mix-blend-mode: screen;
			will-change: transform;
			transition:
				background 0.8s ease,
				opacity 0.8s ease;
		}
		.hero-bg-glow--1 {
			width: 800px;
			height: 800px;
			top: -300px;
			left: 10%;
			background: radial-gradient(
				circle at center,
				color-mix(in srgb, var(--theme-color-primary) 22%, transparent) 0%,
				color-mix(in srgb, var(--theme-color-primary) 14%, transparent) 30%,
				color-mix(in srgb, var(--theme-color-primary) 6%, transparent) 60%,
				color-mix(in srgb, var(--theme-color-primary) 1%, transparent) 85%,
				transparent 100%
			);
			opacity: 0.35;
			animation: glow-drift-1 30s ease-in-out infinite alternate;
		}
		.hero-bg-glow--2 {
			width: 700px;
			height: 700px;
			bottom: -200px;
			right: 10%;
			background: radial-gradient(
				circle at center,
				color-mix(in srgb, var(--theme-color-secondary) 18%, transparent) 0%,
				color-mix(in srgb, var(--theme-color-secondary) 11%, transparent) 35%,
				color-mix(in srgb, var(--theme-color-secondary) 5%, transparent) 65%,
				color-mix(in srgb, var(--theme-color-secondary) 1%, transparent) 85%,
				transparent 100%
			);
			opacity: 0.25;
			animation: glow-drift-2 35s ease-in-out infinite alternate;
		}
		.hero-bg-glow--3 {
			width: 600px;
			height: 600px;
			top: 20%;
			right: 20%;
			background: radial-gradient(
				circle at center,
				rgba(168, 85, 247, 0.18) 0%,
				rgba(168, 85, 247, 0.11) 30%,
				rgba(168, 85, 247, 0.05) 60%,
				rgba(168, 85, 247, 0.01) 85%,
				transparent 100%
			);
			opacity: 0.3;
			animation: glow-drift-3 24s ease-in-out infinite alternate;
		}
		.hero-bg-glow--4 {
			width: 550px;
			height: 550px;
			bottom: 5%;
			left: 5%;
			background: radial-gradient(
				circle at center,
				rgba(6, 182, 212, 0.18) 0%,
				rgba(6, 182, 212, 0.11) 30%,
				rgba(6, 182, 212, 0.05) 60%,
				rgba(6, 182, 212, 0.01) 85%,
				transparent 100%
			);
			opacity: 0.25;
			animation: glow-drift-4 32s ease-in-out infinite alternate;
		}
		.hero-noise {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 0.022;
			pointer-events: none;
			z-index: 1;
			background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 250 250' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
			mask-image: linear-gradient(to bottom, black 70%, transparent 100%);
		}
		.hero-grid {
			position: absolute;
			inset: 0;
			z-index: 2;
			background-image:
				linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
				linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
			background-size: 60px 60px;
			mask-image: radial-gradient(
				ellipse at 50% 35%,
				black 10%,
				transparent 60%
			);
			animation: grid-pulse 12s ease-in-out infinite alternate;
		}
		.hero-title {
			color: white;
			text-shadow:
				0 0 80px var(--theme-color-glow),
				0 0 160px rgba(255, 255, 255, 0.05);
		}
		.animate-gradient {
			background-size: 200% auto;
			animation: gradient-shift 20s ease-in-out infinite;
		}

		/* ===== GLOW CARD SYSTEM ===== */
		.glow-card {
			position: relative;
			border-radius: 1.25rem;
			background: linear-gradient(
				135deg,
				rgba(255, 255, 255, 0.06),
				rgba(255, 255, 255, 0.02)
			);
			border: 1px solid rgba(255, 255, 255, 0.08);
			padding: 1.75rem;
			overflow: hidden;
			transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
			backdrop-filter: blur(10px);
		}
		/* Top shimmer line */
		.glow-card::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background: linear-gradient(
				90deg,
				transparent,
				var(--theme-color-primary),
				var(--theme-color-secondary),
				transparent
			);
			opacity: 0.5;
			transition: opacity 0.5s ease;
		}
		/* Inner corner glow */
		.glow-card::after {
			content: "";
			position: absolute;
			top: -50%;
			left: -50%;
			width: 200%;
			height: 200%;
			background: radial-gradient(
				circle at 30% 30%,
				var(--theme-color-glow),
				transparent 50%
			);
			opacity: 0;
			transition: opacity 0.5s ease;
			pointer-events: none;
		}
		.glow-card:hover {
			border-color: var(--theme-color-primary);
			background: linear-gradient(
				135deg,
				rgba(255, 255, 255, 0.1),
				rgba(255, 255, 255, 0.04)
			);
			transform: translateY(-6px);
			box-shadow:
				0 0 30px var(--theme-color-glow),
				0 20px 40px rgba(0, 0, 0, 0.4);
		}
		.glow-card:hover::before {
			opacity: 1;
		}
		.glow-card:hover::after {
			opacity: 1;
		}

