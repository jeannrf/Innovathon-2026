---
interface Props {
	puestoNum: string;
	title: string;
	description: string;
	cashAmount: string;
	items: string[];
	color: string;
}

const { puestoNum, title, description, cashAmount, items, color } = Astro.props;
---

<div class="glow-card flex flex-col items-center text-center p-8 relative overflow-hidden group">
	<!-- Ambient glow for this card -->
	<div class="absolute top-10 left-1/2 -translate-x-1/2 w-24 h-24 opacity-20 blur-2xl rounded-full group-hover:opacity-40 transition-opacity duration-500" style={`background-color: ${color};`}></div>
	
	<!-- Medal SVG -->
	<svg class="w-20 h-20 mb-6 relative z-10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style={`color: ${color};`}>
		<circle cx="12" cy="15" r="7" />
		<path d="M8.5 9L4 2h4l4 5" />
		<path d="M15.5 9L20 2h-4l-4 5" />
		<text x="12" y="17.5" text-anchor="middle" font-family="sans-serif" font-size="8" font-weight="bold" fill="currentColor" stroke="none">{puestoNum}</text>
	</svg>

	<h3 class="text-2xl font-bold mb-2" style={`color: ${color};`}>{title}</h3>
	<p class="text-slate-300 font-medium mb-6 leading-tight" set:html={description}></p>
	
	<div class="w-full h-px bg-white/10 mb-6"></div>
	
	<div class="space-y-2 mb-10">
		<p class="text-slate-200 font-semibold text-lg">{cashAmount}</p>
		{items.map((item) => (
			<p class="text-slate-400 font-light text-sm">{item}</p>
		))}
	</div>
	
	<!-- SVG Prize Slot -->
	<slot name="prize-icon" />
</div>
