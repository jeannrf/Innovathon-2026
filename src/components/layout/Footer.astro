---
// src/components/layout/Footer.astro
const year = new Date().getFullYear();

const sectionLinks = [
  { href: "/bases", label: "Bases" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/como-participar", label: "Cómo participar" },
  { href: "/cronograma", label: "Cronograma" },
  { href: "/desafios", label: "Desafíos" },
];

const legalLinks = [
  { href: "#", label: "Términos y condiciones" },
  { href: "#", label: "Políticas de privacidad" },
  { href: "#", label: "Preguntas Frecuentes" },
];

const socialLinks = [
  {
    href: "#",
    label: "WhatsApp",
    viewBox: "0 0 32 32",
    icon: `<path fill-rule="evenodd" clip-rule="evenodd" d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z"/>`,
  },
  {
    href: "#",
    label: "Discord",
    icon: `<path fill-rule="evenodd" clip-rule="evenodd" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.33c-1.18 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.18 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>`,
  },
  {
    href: "#",
    label: "Instagram",
    icon: `<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>`,
  },
];
---

<footer class="footer">
  <!-- Top gradient line -->
  <div class="footer__gradient-line"></div>

  <div class="container-custom">
    <!-- Main Grid -->
    <div class="footer__grid">
      <!-- Brand Column -->
      <div class="footer__brand">
        <a href="/" class="footer__brand-header" aria-label="Ir al inicio">
          <span class="footer__brand-name">Innovathon 2026</span>
        </a>
        <p class="footer__brand-tagline">"Launch with AI"</p>
        <p class="footer__description">
          Impulsando el emprendimiento universitario con inteligencia
          artificial. Organizado por la alianza TinkuyLabs - Unicode.
        </p>

        <!-- Social Icons -->
        <div class="footer__social">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="footer__social-link"
                aria-label={social.label}
                title={social.label}
              >
                <svg
                  class="w-5 h-5"
                  fill="currentColor"
                  viewBox={social.viewBox || "0 0 24 24"}
                  set:html={social.icon}
                />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Sections -->
      <div>
        <h4 class="footer__heading">Secciones</h4>
        <ul class="footer__list">
          {
            sectionLinks.map((link) => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="footer__heading">Legal</h4>
        <ul class="footer__list">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="footer__heading">Contacto</h4>
        <ul class="footer__list">
          <li class="footer__contact-item">
            <svg
              class="w-4 h-4 text-[--color-primary-light] shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
              ></path>
            </svg>
            <a href="mailto:tinkuylabs@uni.edu.pe" class="footer__link"
              >tinkuylabs@uni.edu.pe</a
            >
          </li>
          <li class="footer__contact-item">
            <svg
              class="w-4 h-4 text-[--color-primary-light] shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
            <span class="footer__link">+51 980 270 642</span>
          </li>
          <li class="footer__contact-item">
            <svg
              class="w-4 h-4 text-[--color-primary-light] shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
              ></path>
            </svg>
            <span class="footer__link">UNI, Lima, Perú</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p>
        &copy; {year} Innovathon – TinkuyLabs. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: oklch(0.11 0.02 280);
    padding: 4rem 0 2rem;
  }

  .footer__gradient-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--theme-color-primary),
      var(--theme-color-secondary),
      transparent
    );
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer__brand-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .footer__brand-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: white;
  }
  .footer__brand-badge {
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    border-radius: 9999px;
    background: linear-gradient(
      135deg,
      oklch(0.72 0.19 290 / 0.2),
      oklch(0.72 0.16 250 / 0.2)
    );
    color: oklch(0.8 0.15 290);
    border: 1px solid oklch(0.72 0.19 290 / 0.2);
  }
  .footer__brand-tagline {
    font-size: 0.875rem;
    font-weight: 500;
    font-style: italic;
    color: oklch(0.65 0.04 250);
    margin-bottom: 1rem;
  }
  .footer__description {
    font-size: 0.875rem;
    color: oklch(0.55 0.02 250);
    line-height: 1.7;
    max-width: 20rem;
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 0.625rem;
    background: oklch(1 0 0 / 0.05);
    border: 1px solid oklch(1 0 0 / 0.08);
    color: oklch(0.65 0.02 250);
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .footer__social-link:hover {
    color: white;
    background: var(--theme-color-glow);
    border-color: var(--theme-color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--theme-color-glow);
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__link {
    font-size: 0.8125rem;
    color: oklch(0.55 0.02 250);
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .footer__link:hover {
    color: var(--theme-color-primary);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid oklch(1 0 0 / 0.06);
    font-size: 0.75rem;
    color: oklch(0.45 0.02 250);
    text-align: center;
  }
  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer__made-with {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
</style>
