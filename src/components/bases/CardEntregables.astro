<div class="py-4 max-w-3xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
    <!-- Connecting Line for MD screens -->
    <div class="hidden md:block absolute top-11 left-[15%] right-[15%] h-[2px] bg-gradient-to-r from-[var(--theme-color-primary)]/20 to-[var(--theme-color-secondary)]/20 z-0"></div>

    <!-- Step 1 -->
    <div class="relative z-10 text-center flex flex-col items-center group step-theme-1">
      <!-- Glow background (uses local primary purple) -->
      <div class="absolute top-0 w-12 h-12 bg-[var(--theme-color-primary)]/10 rounded-full blur-xl pointer-events-none group-hover:bg-[var(--theme-color-primary)]/25 transition-all duration-300"></div>
      <div class="w-14 h-14 rounded-full bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] p-[2px] flex items-center justify-center mb-3 shadow-[0_0_20px_var(--theme-color-glow)] transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full rounded-full bg-[#141219] flex items-center justify-center">
          <span class="text-base font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)]">1</span>
        </div>
      </div>
      <span class="text-xs font-bold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] uppercase tracking-wider mb-1.5">Idea</span>
      <h4 class="text-sm md:text-base font-semibold text-white">Video Pitch</h4>
    </div>

    <!-- Step 2 -->
    <div class="relative z-10 text-center flex flex-col items-center group step-theme-2">
      <!-- Glow background (uses local primary purple) -->
      <div class="absolute top-0 w-12 h-12 bg-[var(--theme-color-primary)]/10 rounded-full blur-xl pointer-events-none group-hover:bg-[var(--theme-color-primary)]/25 transition-all duration-300"></div>
      <div class="w-14 h-14 rounded-full bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] p-[2px] flex items-center justify-center mb-3 shadow-[0_0_20px_var(--theme-color-glow)] transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full rounded-full bg-[#141219] flex items-center justify-center">
          <span class="text-base font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)]">2</span>
        </div>
      </div>
      <span class="text-xs font-bold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] uppercase tracking-wider mb-1.5">Prototipo</span>
      <h4 class="text-sm md:text-base font-semibold text-white">Prototipo & GitHub</h4>
    </div>

    <!-- Step 3 -->
    <div class="relative z-10 text-center flex flex-col items-center group step-theme-3">
      <!-- Glow background (uses local primary purple) -->
      <div class="absolute top-0 w-12 h-12 bg-[var(--theme-color-primary)]/10 rounded-full blur-xl pointer-events-none group-hover:bg-[var(--theme-color-primary)]/25 transition-all duration-300"></div>
      <div class="w-14 h-14 rounded-full bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] p-[2px] flex items-center justify-center mb-3 shadow-[0_0_20px_var(--theme-color-glow)] transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full rounded-full bg-[#141219] flex items-center justify-center">
          <span class="text-base font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)]">3</span>
        </div>
      </div>
      <span class="text-xs font-bold text-transparent bg-clip-text bg-gradient-to-r from-[var(--theme-color-primary)] to-[var(--theme-color-secondary)] uppercase tracking-wider mb-1.5">Validación</span>
      <h4 class="text-sm md:text-base font-semibold text-white">Demo Day</h4>
    </div>
  </div>
</div>
