---
interface Props {
  value: string;
  label: string;
  className?: string;
}

const { value, label, className = "" } = Astro.props;
---

<div class={`glow-card glow-card--stat ${className}`}>
  <p
    class="text-4xl md:text-5xl font-extralight bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent"
  >
    {value}
  </p>
  <p class="text-slate-400 text-sm mt-2">{label}</p>
</div>
