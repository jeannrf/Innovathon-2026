---
// src/components/OrgCard.astro
interface Props {
  name: string;
  linkedin?: string;
  logo?: string;
}

const { name, linkedin, logo = "" } = Astro.props;

const hasLink = linkedin && linkedin !== "#";
const Tag = hasLink ? "a" : "div";
---

<Tag
  href={hasLink ? linkedin : undefined}
  target={hasLink ? "_blank" : undefined}
  rel={hasLink ? "noopener noreferrer" : undefined}
  class={`org-card ${hasLink ? "org-card--has-link" : ""} group`}
>
  <!-- Borde de resplandor sutil arriba -->
  <div class="org-card__glow-border"></div>

  <!-- Logo Container -->
  <div class="org-card__logo-wrapper">
    {
      logo ? (
        <img src={logo} alt={name} class="org-card__logo" />
      ) : (
        <span class="org-card__placeholder">{name}</span>
      )
    }
  </div>
</Tag>

<style>
  .org-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0);
    border: 1px solid rgba(255, 255, 255, 0);
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    padding: 1.5rem;
    cursor: default;
  }

  .org-card--has-link {
    cursor: pointer;
  }

  .org-card__glow-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--theme-color-primary),
      var(--theme-color-secondary),
      transparent
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .org-card__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .org-card__logo {
    max-width: 90%;
    max-height: 80%;
    object-fit: contain;
    filter: brightness(0.85) contrast(1);
    opacity: 0.7;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* If there's no logo image, show placeholder text */
  .org-card__placeholder {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.35);
    text-align: center;
    letter-spacing: 0.05em;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* HOVER STATES */
  .org-card--has-link::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--theme-color-primary);
    box-shadow:
      0 0 30px var(--theme-color-glow),
      0 12px 24px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 1;
  }

  .org-card:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .org-card--has-link:hover {
    transform: translateY(-4px);
    border-color: transparent;
  }

  .org-card--has-link:hover::after {
    opacity: 1;
  }

  .org-card--has-link:hover .org-card__glow-border {
    opacity: 1;
  }

  .org-card--has-link:hover .org-card__logo-wrapper {
    transform: scale(1.05);
  }

  .org-card--has-link:hover .org-card__logo {
    filter: brightness(1.1) contrast(1);
    opacity: 1;
  }

  .org-card--has-link:hover .org-card__placeholder {
    color: white;
  }
</style>
